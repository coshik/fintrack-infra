pipeline {
  agent { label 'docker-agent' }
  options { timeout(time: 10, unit: 'MINUTES') }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build') { steps { sh 'echo "Building account-service:v2..."' } }
    stage('Deploy Canary') { steps { sh 'echo "Deploying account-service:v2 canary..."' } }
    stage('Health Check') { steps { sh 'echo "Simulating failed health check..."; exit 1' } }
  }
  post {
    failure {
      sh '''
        LAST_GOOD_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "none")
        echo "Rolling back to $LAST_GOOD_TAG..."
      '''
      echo "NOTIFY: Pipeline failed and rolled back to last good tag. (placeholder for real Slack/email step)"
    }
  }
}
