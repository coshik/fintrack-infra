pipeline {
  agent { label 'docker-agent' }
  options { timeout(time: 10, unit: 'MINUTES') }
  stages {
    stage('Checkout') { steps { checkout scm } }
    stage('Build') { steps { sh 'echo "Building account-service:v2..."' } }
    stage('Deploy Canary') { steps { sh 'echo "Deploying account-service:v2 canary..."' } }
    stage('Check Istio 5xx Rate') {
      steps {
        script {
          def result = sh(script: '''
            curl -s -G 'http://172.31.4.123:31823/api/v1/query' \
              --data-urlencode 'query=sum(rate(istio_requests_total{destination_service=~"account-service.*",response_code=~"5.."}[1m]))' \
              | grep -oP '"value":\\[[0-9.]+,"\\K[0-9.]+' || echo "0"
          ''', returnStdout: true).trim()
          if (result == "") { result = "0" }
          echo "account-service 5xx rate (per sec, 1m window): ${result}"
          if (result.toFloat() > 0) {
            error("Istio reports real 5xx errors on account-service (rate=${result}/sec) - triggering rollback")
          }
        }
      }
    }
  }
  post {
    unsuccessful {
      node('built-in') {
        checkout scm
        sh '''
          LAST_GOOD_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "none")
          echo "Rolling back to $LAST_GOOD_TAG..."
        '''
        echo "NOTIFY: Pipeline did not succeed (result: ${currentBuild.currentResult}) - rolled back to last good tag. Ran on built-in node since the deploy agent may be unavailable."
      }
    }
  }
}

